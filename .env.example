# Supabase project connection (Page 1 data: club registration + president
# verification). The anon key is safe to expose client-side — it carries no
# privilege on its own, access is controlled by RLS policies in
# supabase/schema.sql. Copy this file to .env.local and fill in your
# project's real values (Supabase dashboard -> Project Settings -> API).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Comma-separated list of Google emails allowed to sign in as a Toasty
# founder (/founder-login, club/president approvals). Must match the
# founder email(s) used in the RLS UPDATE policies in supabase/schema.sql.
VITE_FOUNDER_EMAILS=
