# Backend DB connection — copy any of these you want to override locally.
# DB_PASSWORD is intentionally NOT set here and should never be committed.
# Supply it as a shell environment variable each time you start the server:
#   PowerShell: $env:DB_PASSWORD='...'; npm run server
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_NAME=toasty
# DB_PASSWORD=
